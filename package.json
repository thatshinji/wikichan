{
  "name": "wikichan",
  "version": "0.1.1",
  "description": "Auto-generate project documentation from code analysis + LLM",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wikichan": "dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "documentation",
    "code-analysis",
    "llm",
    "wiki",
    "ast",
    "tree-sitter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatshinji/wikichan.git"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0",
    "openai": "^4.86.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
